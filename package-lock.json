{
    "name": "offline-first-poc",
    "version": "0.0.0",
    "lockfileVersion": 3,
    "requires": true,
    "packages": {
        "": {
            "name": "offline-first-poc",
            "version": "0.0.0",
            "workspaces": [
                "packages/*",
                "apps/*",
                "server*"
            ]
        },
        "apps/mobile": {
            "name": "@offline-poc/mobile",
            "version": "0.0.0"
        },
        "node_modules/@offline-poc/mobile": {
            "resolved": "apps/mobile",
            "link": true
        },
        "node_modules/@offline-poc/server": {
            "resolved": "server",
            "link": true
        },
        "node_modules/@offline-poc/shared": {
            "resolved": "packages/shared",
            "link": true
        },
        "packages/shared": {
            "name": "@offline-poc/shared",
            "version": "0.0.0"
        },
        "server": {
            "name": "@offline-poc/server",
            "version": "0.0.0"
        }
    }
}
